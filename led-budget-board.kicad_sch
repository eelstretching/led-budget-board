	(junction
		(at 236.22 86.36)
		(diameter 0)
		(color 0 0 0 0)
		(uuid "1ab88ada-0fec-5eb2-b08b-0d8c6c3d7e65")
	)
	(text "U1 and its parts are the led-processor-board buck (TI's TPS54202HEVM-716 5 V design): 100k / 13.3k with\n75 pF across the top resistor, 0.596 V x (1 + 100/13.3) = 5.08 V; 15 uH; 500 kHz. The 510k enables U1 from\nthe 12 V side. D1 blocks a reversed 12 V lead.\n+5V feeds ribbon pin 15 directly. The Pico gets it on VSYS through D2 (about 4.7 V), so USB and 12 V can\nboth be plugged in: the Pico's own diode keeps VSYS off the USB port and D2 keeps USB out of the buck.\nOn USB alone the Pico runs but the ribbons have no +5V, as on the processor board.\nThe load is small: the Pico and two output boards' level shifters, well under 0.5 A."
		(exclude_from_sim no)
		(at 25.4 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7db33012-999d-5668-9303-0d559f77d0ba")
	)
	(text "Pico 2 W in two 1x20 sockets"
